# Pace — environment variable template.
# Copy this file to .env.local (git-ignored) and fill in real values for local dev.
# Real values live in the Vercel project env for production and preview.
# Never commit .env.local, .env.docker, or any real credentials.

# ── Supabase (Postgres + Auth) ─────────────────────────────────────────────
# Cloud (production / staging): get from https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ── Local Supabase (run `npx supabase start` to get these values) ──────────
# Uncomment and fill in when working against a local Supabase instance.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase start output>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase start output>
#
# When running via Docker Compose (docker compose up), use the Docker-internal
# hostname so the container can reach the host's local Supabase:
# NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
# SUPABASE_SERVICE_ROLE_KEY=<same service_role key>

# ── AI ─────────────────────────────────────────────────────────────────────
# Google Gemini free-tier key. See COST.md and DECISIONS.md D14.
# No local alternative — the real key is required even in local dev.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Google OAuth (Calendar, Drive, Sign-In) ───────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID (Web application type).
# See docs/google-oauth-setup.md for full setup instructions.

# Public client ID — used in the browser for Google Sign-In and Drive Picker.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public API key — used in the browser for the Google Picker API (Drive import).
# Restrict it to the Picker API and your domain in the Cloud Console.
NEXT_PUBLIC_GOOGLE_API_KEY=

# Server-only credentials — never expose to the client bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical public URL of this deployment (no trailing slash).
# Used to build OAuth redirect URIs.
# Example: https://your-app.vercel.app  or  http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=

# ── Supabase Google Auth (Sign-In with Google) ────────────────────────────
# Configure in Supabase dashboard → Authentication → Providers → Google.
# These values come from the same Google OAuth client above.
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=     (same as NEXT_PUBLIC_GOOGLE_CLIENT_ID)
# SUPABASE_AUTH_GOOGLE_SECRET=        (same as GOOGLE_CLIENT_SECRET)
# Supabase handles the callback at <supabase-url>/auth/v1/callback automatically.

# ── Admin ──────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses (lowercase). Server-only.
# Example: admin@example.com,other@example.com
ADMIN_EMAILS=
