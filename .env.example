# Pace — environment variable template.
# Copy this file to .env.local (git-ignored) and fill in real values for local dev.
# Real values live in the Vercel project env for production and preview.
# Never commit .env.local, .env.docker, or any real credentials.

# ── Supabase (Postgres + Auth) ─────────────────────────────────────────────
# Cloud (production / staging): get from https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ── Local Supabase (run `npx supabase start` to get these values) ──────────
# Uncomment and fill in when working against a local Supabase instance.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase start output>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase start output>
#
# When running via Docker Compose (docker compose up), use the Docker-internal
# hostname so the container can reach the host's local Supabase:
# NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
# SUPABASE_SERVICE_ROLE_KEY=<same service_role key>

# ── AI ─────────────────────────────────────────────────────────────────────
# Google Gemini free-tier key. See COST.md and DECISIONS.md D14.
# No local alternative — the real key is required even in local dev.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Admin ──────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses (lowercase). Server-only.
# Example: admin@example.com,other@example.com
ADMIN_EMAILS=
