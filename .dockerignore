# Dependencies (reinstalled inside Docker)
node_modules

# Build output (rebuilt inside Docker)
.next
out
dist
build

# Environment files — never bake secrets into the image
.env
.env.local
.env.*.local
.env.docker

# Supabase local artefacts (not needed in the image)
supabase/.branches
supabase/.temp

# Editor / OS artefacts
.vscode
.idea
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*

# TypeScript incremental
*.tsbuildinfo
next-env.d.ts

# Git
.git
.gitignore

# Docs and test files (not needed at runtime)
docs
src/tests
coverage
